{
  "enabledMcpjsonServers": ["jira", "github"],
  "permissions": {
    "allow": [
      "Bash(npx jest:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:unit:*)",
      "Bash(npm run test:api:*)",
      "Bash(npm audit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh auth status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "mcp__jira__jira_get_issue",
      "mcp__jira__jira_search"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "mcp__github__create_pull_request",
      "mcp__jira__jira_add_comment"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.mjs\"", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-on-edit.mjs\"", "timeout": 120 }
        ]
      }
    ]
  }
}
